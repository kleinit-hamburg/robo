<?xml version='1.0'?>
<robot xmlns:xacro='http://www.ros.org/wiki/xacro' name='garden_quadruped_trot'>
  <xacro:property name='variant' value='quadruped_trot'/>
  <xacro:property name='mass_kg' value='65.0'/>
  <link name='base_link'>
    <visual name='QDP-BASE-001_visual'><origin xyz='0 0 0.46' rpy='0 0 0'/><geometry><box size='0.82 0.34 0.18'/></geometry></visual>
    <collision name='QDP-BASE-001_collision'><origin xyz='0 0 0.46' rpy='0 0 0'/><geometry><box size='0.78 0.3 0.16'/></geometry></collision>
  </link>
  <link name='front_left_thigh'/><link name='front_left_shin'/><link name='front_left_foot'/>
  <joint name='front_left_hip_joint' type='revolute'><parent link='base_link'/><child link='front_left_thigh'/><axis xyz='0 1 0'/><limit lower='-0.85' upper='0.85' effort='55.0' velocity='8.0'/></joint>
  <joint name='front_left_knee_joint' type='revolute'><parent link='front_left_thigh'/><child link='front_left_shin'/><axis xyz='0 1 0'/><limit lower='0.15' upper='1.45' effort='55.0' velocity='8.0'/></joint>
  <link name='front_right_thigh'/><link name='front_right_shin'/><link name='front_right_foot'/>
  <joint name='front_right_hip_joint' type='revolute'><parent link='base_link'/><child link='front_right_thigh'/><axis xyz='0 1 0'/><limit lower='-0.85' upper='0.85' effort='55.0' velocity='8.0'/></joint>
  <joint name='front_right_knee_joint' type='revolute'><parent link='front_right_thigh'/><child link='front_right_shin'/><axis xyz='0 1 0'/><limit lower='0.15' upper='1.45' effort='55.0' velocity='8.0'/></joint>
  <link name='rear_left_thigh'/><link name='rear_left_shin'/><link name='rear_left_foot'/>
  <joint name='rear_left_hip_joint' type='revolute'><parent link='base_link'/><child link='rear_left_thigh'/><axis xyz='0 1 0'/><limit lower='-0.85' upper='0.85' effort='55.0' velocity='8.0'/></joint>
  <joint name='rear_left_knee_joint' type='revolute'><parent link='rear_left_thigh'/><child link='rear_left_shin'/><axis xyz='0 1 0'/><limit lower='0.15' upper='1.45' effort='55.0' velocity='8.0'/></joint>
  <link name='rear_right_thigh'/><link name='rear_right_shin'/><link name='rear_right_foot'/>
  <joint name='rear_right_hip_joint' type='revolute'><parent link='base_link'/><child link='rear_right_thigh'/><axis xyz='0 1 0'/><limit lower='-0.85' upper='0.85' effort='55.0' velocity='8.0'/></joint>
  <joint name='rear_right_knee_joint' type='revolute'><parent link='rear_right_thigh'/><child link='rear_right_shin'/><axis xyz='0 1 0'/><limit lower='0.15' upper='1.45' effort='55.0' velocity='8.0'/></joint>
  <!-- Future CAD references: QDP-BASE-001, QDP-LEG-001. Visual and collision geometry remain separate. -->
</robot>
