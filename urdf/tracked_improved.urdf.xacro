<?xml version='1.0'?>
<robot xmlns:xacro='http://www.ros.org/wiki/xacro' name='garden_tracked_improved'>
  <xacro:property name='variant' value='tracked_improved'/>
  <xacro:property name='mass_kg' value='65.0'/>
  <xacro:property name='track_gauge' value='0.7'/>
  <xacro:property name='wheel_radius' value='0.18'/>
  <xacro:property name='body_clearance' value='0.25'/>
  <link name='base_link'>
    <visual name='TRK2-BASE-001_visual'><origin xyz='0 0 0.35' rpy='0 0 0'/><geometry><box size='0.86 0.56 0.24'/></geometry></visual>
    <collision name='TRK2-BASE-001_collision'><origin xyz='0 0 0.35' rpy='0 0 0'/><geometry><box size='0.78 0.48 0.2'/></geometry></collision>
    <inertial><origin xyz='0 0 0.34' rpy='0 0 0'/><mass value='52.6'/><inertia ixx='1.6270933333333335' ixy='0' ixz='0' iyy='3.494393333333333' iyz='0' izz='4.616526666666666'/></inertial>
  </link>
  <link name='left_wheel'><collision name='left_wheel_collision'><geometry><cylinder radius='0.18' length='0.13'/></geometry></collision></link>
  <joint name='left_joint' type='continuous'><parent link='base_link'/><child link='left_wheel'/><origin xyz='0.16 0.35 0.18' rpy='1.57079632679 0 0'/><axis xyz='0 0 -1'/></joint>
  <link name='right_wheel'><collision name='right_wheel_collision'><geometry><cylinder radius='0.18' length='0.13'/></geometry></collision></link>
  <joint name='right_joint' type='continuous'><parent link='base_link'/><child link='right_wheel'/><origin xyz='0.16 -0.35 0.18' rpy='1.57079632679 0 0'/><axis xyz='0 0 -1'/></joint>
  <!-- Future CAD references: TRK2-BASE-001, TRK2-BELT-VIS-001, TRK2-REAR-SKID-001. Visual and collision geometry remain separate. -->
</robot>
